# EditorConfig para o repositório siteRafa
# Este arquivo é o ponto único de verdade para regras básicas de formatação
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{css,scss,html}]
indent_style = space
indent_size = 2

[*.{cs}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off